# Copy to .env and replace both values with independent random strings.
POSTGRES_PASSWORD=replace-with-long-random-password
OCR_INTERNAL_TOKEN=replace-with-long-random-token
# Optional: disable synthetic workspace creation on a hosted service.
# DEMO_ENABLED=false
# Local development defaults. Hosted settings are described in docs/DEPLOYMENT.md.
DEMO_ENABLED=false
HOUSEHOLD_LIMIT=10
HOUSEHOLD_STORAGE_BYTES=52428800
# Optional. Enables consent-based, redacted investigation summaries using OpenAI.
# Keep this server-only secret out of NEXT_PUBLIC_* variables and source control.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# STORAGE_DRIVER=local
# COOKIE_SECURE=false
# APP_ORIGIN=http://localhost:3000
