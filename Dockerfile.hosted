FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv tesseract-ocr poppler-utils tini && rm -rf /var/lib/apt/lists/*
COPY ocr/requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/ocr && /opt/ocr/bin/pip install --no-cache-dir -r /tmp/requirements.txt
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 OCR_URL=http://127.0.0.1:8000 NODE_OPTIONS=--max-old-space-size=192
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
COPY db ./db
COPY scripts/migrate.mjs scripts/database-config.mjs ./scripts/
COPY ocr/app.py ./ocr/app.py
COPY deploy/supervise.py ./deploy/supervise.py
RUN rm -rf /app/demo && mkdir -p /data/uploads && chown node:node /data/uploads
USER node
EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["/opt/ocr/bin/python","deploy/supervise.py"]
