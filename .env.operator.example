# Copy to .env.operator (ignored). Never commit real credentials.
DATABASE_URL=postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Optional trusted CA file when required by your selected connection endpoint.
# DATABASE_CA_FILE=/absolute/path/to/trusted-ca.pem
STORAGE_DRIVER=supabase
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_KEY=replace-with-server-only-service-key
SUPABASE_STORAGE_BUCKET=household-evidence
HOUSEHOLD_LIMIT=10
HOUSEHOLD_STORAGE_BYTES=52428800
BACKUP_PASSPHRASE=replace-with-at-least-24-random-characters
# Restore only to an empty, separately configured target.
# RESTORE_CONFIRM=EMPTY_TARGET
